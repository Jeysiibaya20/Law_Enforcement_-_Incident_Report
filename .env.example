# Example .env for Law_Enforcement_-_Incident_Report
# Copy this file to .env and fill in real values. Do NOT commit .env to source control.

# Enable the application on this host. Set to 1 for production.
ENABLE_APP=0
APP_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=law_inci
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Optional fallback DB settings (leave empty to disable)
DB_FALLBACK_HOST=
DB_FALLBACK_PORT=3306
DB_FALLBACK_NAME=
DB_FALLBACK_USER=
DB_FALLBACK_PASS=

# Mail settings (used by TwoFactorAuth via mailer.env compatibility)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Alertara PH"

# HanLP language analysis (full HanLP package installed in the project .venv)
HANLP_PYTHON_COMMAND=.venv/Scripts/python.exe
HANLP_LANGUAGE_COMMAND=
